# Environment template — copy to `.env` at the REPOSITORY ROOT and adjust as needed.
# That single file configures the backend for both workflows (Docker Compose and
# `cd backend && uvicorn app.main:app`); `backend/.env` is also read and overrides it.
# Real environment variables take precedence over values in this file.
# Do NOT put real credentials in this file. `.env` is git-ignored.

# --- Backend ---
APP_ENV=development

# Maximum accepted text length (default 1000, configurable per api-contract.md).
MAX_TEXT_LENGTH=1000

# Allowed browser origins (JSON array). Development origins only.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- LLM providers (OpenAI-compatible slots) ---
# The backend tries the configured providers in ascending numeric order and moves
# to the next one when a provider fails (authentication, payment, quota or rate
# limit, missing model, server error, timeout, connection/DNS/TLS error, or an
# empty/invalid answer). There is no provider selector and no vendor is special:
# any provider with an OpenAI-compatible /chat/completions endpoint works, and the
# number of slots is unlimited.
#
# For each integer N (1, 2, 3, ...) define:
#   API_KEY_N          secret key (required)
#   BASE_URL_N         provider base URL; the adapter appends /chat/completions
#                      (required, a trailing slash is ignored)
#   MODEL_N            model ID to send (required)
#   TIMEOUT_SECONDS_N  per-request timeout for this slot (optional, default 20)
#   EXTRA_BODY_N       extra JSON object merged into the request body; it can
#                      never override model, messages or stream (optional)
#   NAME_N             label used only in the logs (optional, default "slot-N")
#
# A slot is used only when API_KEY_N, BASE_URL_N and MODEL_N are all non-empty.
# Indexes may have gaps (1, 2, 5). Each key is read only by the backend, sent
# only to its own provider, and never appears in responses or logs.


API_KEY_1=
BASE_URL_1=
MODEL_1=
NAME_1=

API_KEY_2=
BASE_URL_2=
MODEL_2=
NAME_2=
