# Environment template — copy to `.env` at the REPOSITORY ROOT and adjust as needed.
# That single file configures the backend for both workflows (Docker Compose and
# `cd backend && uvicorn app.main:app`); `backend/.env` is also read and overrides it.
# Real environment variables take precedence over values in this file.
# Do NOT put real credentials in this file. `.env` is git-ignored.

# --- Backend ---
APP_ENV=development

# Maximum accepted text length (default 1000, configurable per api-contract.md).
MAX_TEXT_LENGTH=1000

# Allowed browser origins (JSON array). Development origins only.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- LLM providers ---
# The backend always tries Groq first and automatically retries the same request
# once with Google Gemini when Groq fails for a provider-related reason (quota or
# rate limit, authentication, timeout, connection failure, server error, or an
# unusable response). There is no provider-selection setting: set both keys below
# so the fallback is available, and only the key of the provider being called is
# ever sent.

# --- Groq (primary; OpenAI-compatible Chat Completions API) ---
# Secret. Read only by the backend and never exposed to the frontend, responses,
# or logs. Leave empty in this template and never commit a real key.
# Create a key in the Groq console: https://console.groq.com/keys
GROQ_API_KEY=

# Model ID served by Groq. Default: openai/gpt-oss-20b.
# Override to switch models without a code change.
GROQ_MODEL=openai/gpt-oss-20b

# Per-request timeout in seconds for the Groq adapter.
GROQ_TIMEOUT_SECONDS=30

# --- Google Gemini (fallback provider; generateContent API) ---
# Called automatically when the Groq attempt fails. Secret, handled exactly like
# the Groq key. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model ID. Default: gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite

# Per-request timeout in seconds for the Gemini adapter.
GEMINI_TIMEOUT_SECONDS=30

# --- Evaluation logging (optional, consent-based) ---
# Where a record is appended, one JSON Lines row per correction, and only when
# the request explicitly consents (`store_for_evaluation: true`). The record
# holds the timestamp, the submitted text, the provider and model that produced
# the correction, and the corrected text. Declined requests store nothing, and
# the directory is created on demand. `logs/` is git-ignored.
#
# Default (uncomment to change): <repository root>/logs/corrections.jsonl.
# A relative value is resolved against the process working directory, so prefer
# an absolute path when overriding it for local runs.
# Docker Compose deliberately sets CORRECTION_LOG_PATH=/app/logs/corrections.jsonl
# for the backend service (backed by a ./logs mount) and ignores this value.
# CORRECTION_LOG_PATH=logs/corrections.jsonl
